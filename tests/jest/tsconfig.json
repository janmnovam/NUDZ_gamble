{
  "extends": "../../tsconfig.app.json",
  "compilerOptions": {
    // `vite/client` is needed for the CSS/asset module declarations in src.
    // This is the only tsconfig pulling in `@types/jest`, so the app tsconfig
    // stays free of test globals.
    "types": ["jest", "node", "vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../../src/*"],
      "@ui/*": ["../../src/ui/*"],
      "@domain/*": ["../../src/domain/*"],
      "@data/*": ["../../src/data/*"]
    }
  },
  "include": ["."]
}
